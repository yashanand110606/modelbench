# Environment variables for ModelBench
# Copy this file to .env and update values for your environment

# Development settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS settings - set to True for development, specify origins for production
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key - generate a new one for production
SECRET_KEY=your-secret-key-here

# Optional: Database configuration (using SQLite by default)
# DATABASE_URL=sqlite:///db.sqlite3